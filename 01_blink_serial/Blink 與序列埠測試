const int LED_PIN = 2;

void setup() {
  Serial.begin(115200);
  pinMode(LED_PIN, OUTPUT);
  delay(500);
  Serial.println("ESP32 Boot OK - Blink & Serial Start");
}

void loop() {
  digitalWrite(LED_PIN, HIGH);
  Serial.println("LED: ON");
  delay(500);

  digitalWrite(LED_PIN, LOW);
  Serial.println("LED: OFF");
  delay(500);
}
