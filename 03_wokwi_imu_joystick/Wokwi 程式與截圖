#include <Wire.h>
#include <math.h>

const uint8_t MPU_ADDR = 0x68;
const int JOY_X_PIN = 34;
const int JOY_Y_PIN = 35;

void setup() {
  Serial.begin(115200);
  Wire.begin(21, 22);

  // 喚醒 MPU6050
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x6B); // PWR_MGMT_1
  Wire.write(0x00);
  Wire.endTransmission(true);

  analogReadResolution(12); // 0 ~ 4095
}

void loop() {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x3B); // ACCEL_XOUT_H
  Wire.endTransmission(false);
  Wire.requestFrom(MPU_ADDR, 6, true);

  int16_t rawAx = (Wire.read() << 8) | Wire.read();
  int16_t rawAy = (Wire.read() << 8) | Wire.read();
  int16_t rawAz = (Wire.read() << 8) | Wire.read();

  // ±2g 預設靈敏度：16384 LSB/g
  float ax = rawAx / 16384.0f;
  float ay = rawAy / 16384.0f;
  float az = rawAz / 16384.0f;

  float roll  = atan2(ay, az) * 180.0f / PI;
  float pitch = atan2(-ax, sqrt(ay * ay + az * az)) * 180.0f / PI;

  int joyX = analogRead(JOY_X_PIN);
  int joyY = analogRead(JOY_Y_PIN);

  Serial.printf("Roll: %6.2f deg | Pitch: %6.2f deg | Joy X: %4d | Joy Y: %4d\n",
                roll, pitch, joyX, joyY);
  delay(100);
}
